<?xml version='1.0' encoding='utf-8'?>
<widget id="com.callapp.terminal" version="1.0.0" 
        xmlns="http://www.w3.org/ns/widgets" 
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>CallApp</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />

    <!-- Deep Links - Android & iOS -->
    <preference name="AndroidLaunchMode" value="singleTask" />

    <!-- Android: Intent Filters pour deep links -->
    <platform name="android">
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity[@android:name='MainActivity']">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="callapp" />
                <data android:host="join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="serveur-appel.onrender.com" android:pathPrefix="/join" />
            </intent-filter>
        </config-file>
    </platform>

    <!-- iOS: URL Scheme -->
    <platform name="ios">
        <config-file target="*-Info.plist" parent="CFBundleURLTypes">
            <array>
                <dict>
                    <key>CFBundleURLSchemes</key>
                    <array>
                        <string>callapp</string>
                    </array>
                    <key>CFBundleURLName</key>
                    <string>com.callapp.terminal</string>
                </dict>
            </array>
        </config-file>
    </platform>

    <!-- 1. RÈGLES DE SÉCURITÉ RESEAU (WHITELIST) -->
    <!-- Autorise l'application à communiquer avec n'importe quelle adresse IP/domaine -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- 2. CONFIGURATION SPÉCIFIQUE ANDROID -->
    <platform name="android">

        <!-- CONFIGURATION google pour les notification  -->
        <resource-file src="google-services.json" target="app/google-services.json" />

        <!-- Permet les requêtes HTTP non chiffrées (Cleartext) vers http://192.168.1.188:3000 -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>

        <!-- Demande explicite des permissions réseau et enregistrement audio -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.RECORD_AUDIO" />
            <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
            <uses-permission android:name="android.permission.VIBRATE" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

            <!-- AJOUTS : écran d'appel entrant façon WhatsApp -->
            <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
            <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
            <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

            <!-- AJOUTS Core-Telecom (Android 14+) -->
            <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
        </config-file>

        <!-- Attributs MainActivity : showWhenLocked et turnScreenOn désactivés par défaut (activés uniquement par code Java lors d'un appel entrant) -->
        <edit-config file="app/src/main/AndroidManifest.xml"
                     mode="merge"
                     target="/manifest/application/activity[@android:name='MainActivity']">
            <activity android:showWhenLocked="false"
                      android:turnScreenOn="false"
                      android:launchMode="singleTask"
                      android:exported="true" />
        </edit-config>

        <!-- AJOUT : service FCM natif dédié aux appels, indépendant de la WebView -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <service android:name="com.callapp.terminal.CallMessagingService" android:exported="false">
                <intent-filter>
                    <action android:name="com.google.firebase.MESSAGING_EVENT" />
                </intent-filter>
            </service>

            <receiver android:name="com.callapp.terminal.CallNotificationReceiver" android:exported="false">
                <intent-filter>
                    <action android:name="com.callapp.terminal.ACTION_DECLINE_CALL" />
                    <action android:name="com.callapp.terminal.ACTION_DISMISS_CALL" />
                </intent-filter>
            </receiver>
        </config-file>

        <!-- AJOUT : remplace le MainActivity.java généré par une version qui gère
             le réveil d'écran dynamique + la lecture de l'intent d'appel entrant -->
        <resource-file src="src/android/MainActivity.java"
                        target="app/src/main/java/com/callapp/terminal/MainActivity.java" />

        <!-- AJOUT : service Firebase qui construit la notification plein écran -->
        <resource-file src="src/android/CallMessagingService.java"
                        target="app/src/main/java/com/callapp/terminal/CallMessagingService.java" />

        <!-- AJOUT : receiver pour effacer/rejeter les notifications d'appel -->
        <resource-file src="src/android/CallNotificationReceiver.java"
                        target="app/src/main/java/com/callapp/terminal/CallNotificationReceiver.java" />

         <!-- AJOUT :  -->
        <resource-file src="src/android/IncomingCallActivity.java"
                        target="app/src/main/java/com/callapp/terminal/IncomingCallActivity.java" />
        <!-- AJOUT : déclaration de l'écran d'appel entrant natif -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <activity android:name="com.callapp.terminal.IncomingCallActivity"
                      android:label="Appel Entrant"
                      android:theme="@style/Theme.IncomingCall"
                      android:exported="false"
                      android:excludeFromRecents="true"
                      android:showWhenLocked="true"
                      android:turnScreenOn="true"
                      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|smallestScreenSize" />
        </config-file>

        <!-- AJOUT : adaptateur Kotlin pour Jetpack core-telecom -->
        <resource-file src="src/android/TelecomCallManager.kt"
                        target="app/src/main/java/com/callapp/terminal/TelecomCallManager.kt" />

        <!-- AJOUT : dépendances Gradle pour core-telecom -->
        <resource-file src="src/android/build-extras.gradle"
                        target="app/build-extras.gradle" />

        <!-- AJOUT : icône utilisée par la notification d'appel -->
        <resource-file src="src/android/ic_call.xml"
                        target="app/src/main/res/drawable/ic_call.xml" />

        <!-- AJOUT : icône utilisée par la notification d'appel -->
        <resource-file src="src/android/style_incoming_call.xml" 
                        target="app/src/main/res/values/style_incoming_call.xml" />

        <feature name="AudioRoutePlugin">
            <param name="android-package" value="com.callapp.terminal.AudioRoutePlugin" />
            <param name="onload" value="true" />
        </feature>

        <config-file target="AndroidManifest.xml" parent="/manifest">
        <uses-permission android:name="android.permission.BLUETOOTH" />
        <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
        <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
        <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
        </config-file>

    </platform>

    <!-- 3. CONFIGURATION SPÉCIFIQUE iOS -->
    <platform name="ios">
        <!-- Sans ça, WKWebView ouvre chaque <video> en plein écran natif (ignore playsinline) :
             la caméra locale prenait tout l'écran au lancement de l'appel -->
        <preference name="AllowInlineMediaPlayback" value="true" />

        <!-- Garder l'appel (micro + WebRTC) vivant quand l'app passe en arrière-plan,
             indispensable pendant un partage d'écran ReplayKit (on quitte l'app) -->
        <config-file target="*-Info.plist" parent="UIBackgroundModes">
            <array>
                <string>audio</string>
                <string>remote-notification</string>
            </array>
        </config-file>

        <!-- Permissions pour ReplayKit (capture d'écran) -->
        <config-file target="*-Info.plist" parent="NSMicrophoneUsageDescription">
            <string>Le microphone est nécessaire pour les appels audio et vidéo</string>
        </config-file>
        <config-file target="*-Info.plist" parent="NSCameraUsageDescription">
            <string>La caméra est nécessaire pour les appels vidéo</string>
        </config-file>

        <!-- Feature pour ScreenShareLive -->
        <feature name="ScreenShareLive">
            <param name="ios-package" value="ScreenShareLivePlugin"/>
        </feature>
    </platform>

</widget>